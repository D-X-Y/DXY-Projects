# Get the definition of a training job
describe_run() {
    job=$1
    mast get-job-definition $job --simple-json
}

# Diff two job definitions
diff_jobs() {
    job1=$1
    job2=$2
    mast get-job-definition $job1 --simple-json > /tmp/$job1.json
    mast get-job-definition $job2 --simple-json > /tmp/$job2.json
    vimdiff /tmp/$job1.json /tmp/$job2.json
}

# Get all training job names with a certain prefix
get_jobs() {
    prefix=$1
    mast list-jobs --prefix $prefix --include-historical | cut -f1 -d' '
}

